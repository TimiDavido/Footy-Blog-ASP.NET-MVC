@model List<FootyBlog.Models.Blog>

<!DOCTYPE html>
<html>
<head>
    <title>Footy Blog</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

    <div class="header">
        <h1>FOOTY BLOG</h1>

        <div class="nav">
            <a href="/">Home</a>
            <a href="/create">Create Post</a>
        </div>
    </div>

    <div class="content">

        <div class="news">

            @foreach (var post in Model)
            {
                <div class="card">

                    <img src="@post.ImagePath" alt="@post.Title" />

                    <h2>@post.Title</h2>

                    <p>
                        <em>@post.PostDate.ToString("dd MMM yyyy")</em>
                    </p>

                        @if (post.Content != null && post.Content.Length > 50)
                        {
                            <p>@post.Content.Substring(0,100)...</p>
                        }
                        else
                        {
                            <p>@post.Content</p>
                        }

                    <a href="/details/@post.Id">Read More</a>

                </div>
            }

        </div>

    </div>

</body>
</html>