@model List<FootyBlog.Domain.Entities.Blog>
@{
    ViewData["Title"] = "Home";
    int currentPage = 1;
    int totalPages = 1;

    if (ViewBag.CurrentPage != null)
    {
        currentPage = (int)ViewBag.CurrentPage;
    }

    if (ViewBag.TotalPages != null)
    {
        totalPages = (int)ViewBag.TotalPages;
    }
}

<div class="content">

    @if (Model != null && Model.Count > 0)
    {
        var latest = Model[0];

        <a href="/details/@latest.Id" class="featured-post">
            <div class="featured-image">
                <img src="@latest.ImagePath" alt="@latest.Title" />
            </div>
            <div class="featured-body">
                <h2>@latest.Title</h2>

                @if (latest.Content != null && latest.Content.Length > 220)
                {
                    <p class="excerpt">@latest.Content.Substring(0, 220)...</p>
                }
                else
                {
                    <p class="excerpt">@latest.Content</p>
                }

                <div class="post-meta">
                    <span class="source">Footy Blog</span>
                    <span class="dot">•</span>
                    <span class="date">@latest.PostDate.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </a>
    }

    @if (Model != null && Model.Count > 1)
    {
        <div class="post-grid">
            @for (int i = 1; i < Model.Count; i++)
            {
                var post = Model[i];

                <a href="/details/@post.Id" class="post-card">
                    <div class="post-card-image">
                        <img src="@post.ImagePath" alt="@post.Title" />
                    </div>
                    <div class="post-card-body">
                        <h3>@post.Title</h3>
                        <div class="post-meta">
                            <span class="date">@post.PostDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <p class="no-posts">No posts yet.</p>
    }

</div>

@if (totalPages > 1)
{
    <div class="pagination">

        @if (currentPage > 1)
        {
            <a class="page-link" href="/?page=@(currentPage - 1)">&laquo; Prev</a>
        }
        else
        {
            <a class="page-link disabled" href="#">&laquo; Prev</a>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            if (i == currentPage)
            {
                <a class="page-link active" href="/?page=@i">@i</a>
            }
            else
            {
                <a class="page-link" href="/?page=@i">@i</a>
            }
        }

        @if (currentPage < totalPages)
        {
            <a class="page-link" href="/?page=@(currentPage + 1)">Next &raquo;</a>
        }
        else
        {
            <a class="page-link disabled" href="#">Next &raquo;</a>
        }

    </div>
}