@model FootyBlog.Application.DTOs.RegisterDto
@{
    ViewData["Title"] = "Join";
}

<div class="auth-container">
    <h2>Join Footy Blog</h2>
    <form asp-controller="Account" asp-action="Register" method="post">
        @if (TempData["DuplicateMessage"] != null)
        {
            <div class="duolicate-message">@TempData["DuplicateMessage"]</div>
        }
        <div class="form-group">
            <label asp-for="UserName"></label>
            <input asp-for="UserName" />
            <span asp-validation-for="UserName" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <button type="submit">Join</button>
    </form>
    <a asp-controller="Account" asp-action="Login" class="switch-link">Already have an account? Sign In</a>
</div>
