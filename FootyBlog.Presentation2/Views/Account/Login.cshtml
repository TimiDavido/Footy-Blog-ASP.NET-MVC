@model FootyBlog.Application.DTOs.RegisterDto
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-container">
    <h2>Sign In</h2>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-controller="Account" asp-action="Login" method="post">
        @if(TempData["SuccessMessage"] != null)
            {
                <div class="success-message">@TempData["SuccessMessage"]</div>
            }
            <div class="form-group">
            <label asp-for="UserName"></label>
            <input asp-for="UserName" />
            <span asp-validation-for="UserName" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>

        <button type="submit">Sign In</button>
    </form>
    <a asp-controller="Account" asp-action="Register" class="switch-link">Don't have an account? Join</a>
</div>
